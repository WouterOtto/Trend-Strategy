{
  "indicators": {
    "sma_fast": 50,
    "sma_slow": 200,
    "atr_period": 20,
    "adx_period": 14,
    "adx_smoothing": 14
  },
  "entry": {
    "timing": "monthly_rebalancing_date",
    "order_type": "limit",
    "limit_offset_pct": 0.5,
    "trend_qualification": {
      "sma_50_above_sma_200": true,
      "close_above_sma_50": true,
      "adx_minimum": 20,
      "price_above_sma_200": true
    },
    "momentum_ranking": {
      "lookback_period": 60,
      "method": "rate_of_change",
      "top_n_symbols": 20
    }
  },
  "position_sizing": {
    "target_risk_per_position": 0.02,
    "min_position_pct": 0.005,
    "max_position_pct": 0.08,
    "max_portfolio_positions": 20,
    "share_rounding": "floor"
  },
  "stops": {
    "initial_stop_multiplier": 3.0,
    "trailing_stop_multiplier": 4.0,
    "trailing_activation_profit_pct": 0.15,
    "update_frequency": "weekly_friday",
    "use_ratchet": true
  },
  "rebalancing": {
    "frequency": "monthly",
    "anchor": "last_trading_day",
    "execution": "first_trading_day_next_month",
    "holiday_calendar": "NYSE"
  },
  "risk_management": {
    "max_portfolio_risk": 0.3,
    "max_sector_exposure": 0.4,
    "max_correlation": 0.85,
    "max_concentration_top3": 0.3
  },
  "circuit_breakers": {
    "max_drawdown_pct": -15.0,
    "max_vix": 40,
    "max_correlation": 0.85,
    "max_concentration_top3_pct": 30.0,
    "max_data_staleness_days": 3,
    "action": "halt_new_positions"
  },
  "data_validation": {
    "max_missing_data_days": 5,
    "max_price_spike_pct": 50.0,
    "min_non_zero_prices_pct": 95.0,
    "max_zero_volume_days": 10
  }
}